##############################################################################
#
#  Gradle start up script for POSIX compliant systems
#
##############################################################################

# Attempt to set APP_HOME to the real path of the exe
SELF=$0

# Escape strings for sed
SELF=`cygpath -f "$SELF" -`

# Find the real CLASSPATH
APP_HOME=`dirname "$SELF"`

# Resolve symlinks
prune="true"
while [ -h "$APP_HOME" ]; do
    ls=`ls -ld "$APP_HOME"`
    link=`expr "$ls" : "..* -> \\(.*\\)"`
    if expr "$link" : "/.*" > /dev/null; then
        APP_HOME="$link"
    else
        APP_HOME=`cd "$APP_HOME" && cd "$link" && pwd`
    fi
done

# Resolve relative directories
case "$APP_HOME" in
    /* | \\.*)
        ;;
    *)
        # Add the CWD (the shell's working directory) to the beginning of APP_HOME
        APP_HOME=`cd "$APP_HOME" && pwd`
        ;;
esac

# Resolve the real CLASSPATH
CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

# Determine the Java command to use to start the JVM
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        # IBM's JDK on AIX uses strange locations for the executables
        JAVACMD="$JAVA_HOME/jre/sh/java"
    elif [ -x "$JAVA_HOME/bin/java" ] ; then
        JAVACMD="$JAVA_HOME/bin/java"
    else
        JAVACMD="$JAVA_HOME/bin/java"
    fi
    if [ ! -x "$JAVACMD" ] ; then
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME
Please set the JAVA_HOME variable to point to a valid Java installation."
    fi
else
    JAVACMD="java"
    which java >/dev/null 2>&1 || die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH.
Please set the JAVA_HOME variable to point to a valid Java installation."
fi

# Add default JVM options here. You can also use JAVA_OPTS and GRADLE_OPTS to pass JVM options to this script.
defaults=""

# Ensure that the number of open files is not limited
if [ -x /usr/sbin/sysctl ] && [ -r /usr/sbin/sysctl ]; then
    sysctl -w kern.maxfiles=65536 2>/dev/null || true
fi

# Execute Gradle
exec "$JAVACMD" $defaults $DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS "-Dorg.gradle.appname=$APP_NAME" -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
